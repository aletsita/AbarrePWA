PWA:

# ============================================================================
#  AbarrePWA (caja) · .env  (no se sube a git)
#  En desarrollo (npm run dev) Vite reenvía /api, /hubs, /archivos y /__sync a API_PROXY_TARGET:
#  la caja habla con la API como si fuera el mismo sitio, sin problemas de CORS.
#  Deja SOLO UNA línea API_PROXY_TARGET sin comentar y reinicia npm run dev al cambiarla.
# ============================================================================

# ---------- 1. Railway · develop (rama develop) ----------
API_PROXY_TARGET=https://abarreapi-develop.up.railway.app

# ---------- 2. Railway · production (rama main) ----------
# API_PROXY_TARGET=https://abarreapi-production.up.railway.app

# ---------- 3. API en tu laptop (dotnet run en AbarreAPI) ----------
# API_PROXY_TARGET=http://localhost:8787

# ---------- Al publicar la caja (npm run build) ----------
# El build no usa el proxy: la caja publicada llama directo a la API. Pon la URL del entorno al que va
# y agrega el dominio de la caja en Cors__Origenes__N de ESE entorno en Railway. Se lee al compilar.
# VITE_API_URL=https://abarreapi-develop.up.railway.app
# VITE_API_URL=https://abarreapi-production.up.railway.app